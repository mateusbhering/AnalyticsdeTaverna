# Copie para .env e preencha. NUNCA versione o .env com valores reais.

# Redis (fila arq + resultados)
REDIS_URL=redis://localhost:6379

# Google Gemini — obrigatório em produção. Obtenha em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo de imagem (opcional). Padrão: gemini-3.1-flash-image (Nano Banana 2, jul/2026).
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
