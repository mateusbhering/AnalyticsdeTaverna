# Copie para .env e preencha. NUNCA versione o .env com valores reais.

# Redis (fila arq + resultados)
REDIS_URL=redis://localhost:6379

# Google Gemini — obrigatório em produção. Obtenha em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo de imagem (opcional). Padrão: gemini-3.1-flash-image (Nano Banana 2, jul/2026).
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Supabase — o worker sobe o avatar GERADO ao Storage (bucket "avatars").
# Obrigatório em produção. Estes são os nomes que o backend Python lê
# (NÃO os NEXT_PUBLIC_*, que são do frontend).
SUPABASE_URL=https://ikhlzadeqttjywuaaogw.supabase.co
# SECRETO — Supabase → Project Settings → API → service_role. NUNCA commite o
# valor real nem exponha no frontend (bypassa o RLS).
SUPABASE_SERVICE_ROLE_KEY=