# Copie para .env e preencha. NUNCA versione o .env com valores reais.
# (O .gitignore do projeto já ignora .env — confira antes do primeiro commit.)

# ── Redis (fila do avatar) ──────────────────────────────────────────
# OPCIONAL em desenvolvimento. Sem Redis a API sobe assim mesmo; só as rotas
# de /avatar ficam indisponíveis. Cadastro, batalha, ranking e analytics
# funcionam normalmente.
REDIS_URL=redis://localhost:6379

# ── Supabase (banco) ────────────────────────────────────────────────
# OBRIGATÓRIO para as rotas de cadastro, batalha, ranking e analytics.
# Sem isso elas respondem 503 com uma mensagem explicando o que falta.
#
# Onde achar: Supabase → Project Settings → API
SUPABASE_URL=https://ikhlzadeqttjywuaaogw.supabase.co
# SECRETO — é a chave service_role (sb_secret_...). Ela IGNORA o RLS, então
# tem poder total sobre o banco. Só no backend. NUNCA no frontend, nunca no
# git, nunca no print da apresentação.
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Gemini (geração de avatar) ───────────────────────────────
# Obrigatório só se você for mexer nas rotas de avatar.
# Obtenha em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo de imagem (opcional). Padrão: gemini-3.1-flash-image.
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
